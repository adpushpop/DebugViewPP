    LTEXT           "{,5}",IDC_STATIC,12,153,16,8
    LTEXT           "最多5个",IDC_STATIC,35,153,66,8
    LTEXT           "{2,}",IDC_STATIC,12,164,16,8
    LTEXT           "至少2个",IDC_STATIC,35,164,66,8
    GROUPBOX        "字符类",IDC_STATIC,104,7,110,96
