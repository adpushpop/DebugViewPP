IDR_MAINFRAME MENU
BEGIN
    POPUP "&文件"
    BEGIN
        MENUITEM "新建&视图\tCtrl+N",           ID_FILE_NEWVIEW
        MENUITEM "&打开...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM "&运行...",                     ID_FILE_RUN
        MENUITEM SEPARATOR
        MENUITEM "保存所选内容\tAlt+S",       ID_FILE_SAVE_VIEW_SELECTION
        MENUITEM "保存视图\tCtrl+S",           ID_FILE_SAVE_VIEW
        MENUITEM "&保存日志\tCtrl+Shift+S",     ID_FILE_SAVE_LOG
        MENUITEM SEPARATOR
        MENUITEM "加载配置...",       ID_FILE_LOAD_CONFIGURATION
        MENUITEM "保存配置...",       ID_FILE_SAVE_CONFIGURATION
        MENUITEM SEPARATOR
        MENUITEM "退&出",                       ID_APP_EXIT
    END
    POPUP "&日志"
    BEGIN
        MENUITEM "&清空日志\tCtrl+Shift+X",    ID_LOG_CLEAR
        MENUITEM "将日志裁剪为所选内容",      ID_LOG_CROP
        MENUITEM "&暂停\t暂停",               ID_LOG_PAUSE
        MENUITEM "捕获全局Win32日志",       ID_LOG_GLOBAL
        MENUITEM "捕获内核消息",    ID_LOG_KERNEL
        MENUITEM "详细内核消息",    ID_LOG_KERNEL_VERBOSE
        MENUITEM "直通模式",          ID_LOG_KERNEL_PASSTHROUGH
        MENUITEM "连接DebugView代理",    ID_LOG_DEBUGVIEW_AGENT
        MENUITEM "来源...",                  ID_LOG_SOURCES
        MENUITEM "历史大小...",             ID_LOG_HISTORY
    END
    POPUP "&视图"
    BEGIN
        MENUITEM "清空视图",          ID_VIEW_CLEAR
        MENUITEM "重置视图",                  ID_VIEW_RESET
        MENUITEM "重置视图到当前行",     ID_VIEW_RESET_TO_LINE
        MENUITEM "全&选\tCtrl+A",         ID_VIEW_SELECTALL
        MENUITEM "&复制\tCtrl+C",               ID_VIEW_COPY
        MENUITEM "自动滚动",                 ID_VIEW_SCROLL
        MENUITEM "停止自动滚动",            ID_VIEW_SCROLL_STOP
        MENUITEM "显示时间\tCtrl+T",          ID_VIEW_TIME
        MENUITEM "进程着色",              ID_VIEW_PROCESSCOLORS
        MENUITEM SEPARATOR
        POPUP "&书签"
        BEGIN
            MENUITEM "&添加书签\tCtrl+F2",          ID_VIEW_BOOKMARK
            MENUITEM "下一个书签\tF2",           ID_VIEW_NEXT_BOOKMARK
            MENUITEM "上一个书签\tShift+F2", ID_VIEW_PREVIOUS_BOOKMARK
            MENUITEM "清空所有书签\tCtrl+Shift+F2", ID_VIEW_CLEAR_BOOKMARKS
        END
        MENUITEM "过滤器...\tF5",              ID_VIEW_FILTER
    END
    POPUP "选项"
    BEGIN
        MENUITEM "&关联视图",                 ID_OPTIONS_LINKVIEWS
        MENUITEM "&自动换行",               ID_OPTIONS_AUTONEWLINE
        MENUITEM "&显示进程ID前缀",                 ID_OPTIONS_PROCESS_PREFIX
        MENUITEM "&字体...",                    ID_OPTIONS_FONT
        MENUITEM "始终&置顶",              ID_OPTIONS_ALWAYSONTOP
        MENUITEM "最小化时&隐藏",        ID_OPTIONS_HIDE
    END
    POPUP "&帮助"
    BEGIN
        MENUITEM "&关于DebugViewAd++...",       ID_APP_ABOUT
    END
END

